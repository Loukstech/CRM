# Modèle de configuration — AUCUN SECRET RÉEL ICI.
# `npm run setup` copie ce fichier vers .env en remplaçant les valeurs
# __GENERATED_*__ par des secrets aléatoires. .env n'est jamais versionné.

NODE_ENV=development
PORT=3000

# --- Base de données -------------------------------------------------------
# Connexion d'exécution de l'API : rôle crm_app (sans privilège, soumis à la RLS).
# L'API refuse de démarrer si ce rôle est superutilisateur ou BYPASSRLS.
DATABASE_URL=postgresql://crm_app:__GENERATED_DB_APP_PASSWORD__@127.0.0.1:54329/crm_dev
# Connexion de migration : rôle propriétaire du schéma (DDL, catalogue de permissions).
DATABASE_MIGRATION_URL=postgresql://postgres:__GENERATED_DB_OWNER_PASSWORD__@127.0.0.1:54329/crm_dev

# --- Authentification ------------------------------------------------------
# Secret de signature des jetons d'accès (HS256), 32 caractères minimum.
JWT_ACCESS_SECRET=__GENERATED_JWT_SECRET__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Limitation de débit (en mémoire : une seule instance d'API) -----------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- HTTP ------------------------------------------------------------------
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune.
CORS_ORIGINS=http://localhost:5173
# Mettre à 1 uniquement derrière un reverse proxy de confiance (X-Forwarded-For).
TRUST_PROXY=0
# URL de l'application web, utilisée dans les liens des e-mails.
APP_WEB_URL=http://localhost:5173
# Documentation Swagger sur /api/docs (désactivée par défaut en production).
SWAGGER_ENABLED=1

# --- E-mails ---------------------------------------------------------------
# Pilote d'envoi :
#   log   : n'envoie RIEN, journalise le message dans la console (développement).
#   smtp  : envoie via un serveur SMTP (ex. Hostinger). Interdit en dev si les
#           paramètres SMTP sont absents ; requis en production (log interdit).
MAIL_DRIVER=log
# Paramètres SMTP (requis si MAIL_DRIVER=smtp, surtout en production).
# Exemple Hostinger : hôte smtp.hostinger.com, port 465 (SSL) ou 587 (STARTTLS).
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=contact@tondomaine.com
MAIL_PASSWORD=
MAIL_FROM="CRM <contact@tondomaine.com>"
