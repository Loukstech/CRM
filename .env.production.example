# Variables d'environnement pour la PRODUCTION (Render / PaaS).
# À saisir dans le dashboard de la plateforme (Environment Group ou render.yaml).
# Les valeurs entre <...> sont à remplacer. Celles fournies par la plateforme (base, JWT)
# sont gérées automatiquement par le Blueprint render.yaml.
#
# ATTENTION : ce fichier est ignoré par git (.env.*) — ne jamais y mettre de vrai secret
# dans une version commitée.

NODE_ENV=production

# DATABASE_URL / DATABASE_MIGRATION_URL : à saisir dans le dashboard.
# Deux URL distinctes, c'est volontaire :
#   DATABASE_URL           -> rôle applicatif soumis à la RLS (ex. crm_app)
#   DATABASE_MIGRATION_URL -> rôle propriétaire, utilisé par `prisma migrate deploy`
# L'API refuse de démarrer si DATABASE_URL utilise un rôle superuser / BYPASSRLS.
# Ex. Neon : postgresql://crm_app:pass@ep-xxx.neon.tech/neondb?sslmode=require

JWT_ACCESS_SECRET=<généré automatiquement par la plateforme>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

CORS_ORIGINS=https://crm.timestradinginter.com
TRUST_PROXY=1
APP_WEB_URL=https://crm.timestradinginter.com
SWAGGER_ENABLED=1

# ---------------------------------------------------------------------------
# E-mails
# ---------------------------------------------------------------------------
# Trois pilotes possibles :
#   log  -> n'envoie rien, écrit dans les logs (INTERDIT en production)
#   smtp -> serveur SMTP classique (ports 25/465/587)
#   http -> API HTTPS d'un fournisseur (Brevo, Resend) : port 443
#
# Sur une instance Free de Render, `smtp` échoue toujours : Render filtre les
# ports sortants 25, 465 et 587 (https://render.com/docs/free). Utiliser `http`.
MAIL_DRIVER=http
MAIL_HTTP_PROVIDER=brevo
MAIL_HTTP_API_KEY=<clé-API-Brevo>
MAIL_FROM="CRM <contact@timestradinginter.com>"

# Variante SMTP (si l'hébergeur autorise les ports SMTP sortants) :
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USER=<contact@ton-domaine.com>
# MAIL_PASSWORD=<mot-de-passe-de-la-boite>
# MAIL_FROM="CRM <contact@ton-domaine.com>"
